// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents UserOnDocument[]

  @@map("users")
}

model Document {
  id             String   @id @default(uuid())
  extractionDate DateTime @default(now())
  customerName   String
  supplierName   String
  filePath       String   // Path: <extractionDate>/<customerName>-<supplierName>/
  fileName       String
  mimeType       String   @default("application/pdf")
  fileSize       Int?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users UserOnDocument[]

  @@index([extractionDate])
  @@index([customerName, supplierName])
  @@map("documents")
}

model UserOnDocument {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  role       String   @default("viewer") // viewer, editor, owner
  assignedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("users_on_documents")
}
