// Prisma schema for PostgreSQL (Docker mode)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents UserOnDocument[]
  sessions  Session[]
  settings  UserSettings?

  @@map("users")
}

model UserSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  openaiApiKeyEncrypted String?
  openaiApiKeyIv        String?
  openaiApiKeyTag       String?

  // LLM Provider Selection
  llmProvider       String @default("openai") // "openai" | "ollama"

  // Ollama Configuration
  ollamaBaseUrl     String @default("http://localhost:11434")
  ollamaTextModel   String @default("llama3.2:3b")
  ollamaVisionModel String @default("llava:7b-v1.6-mistral-q4_K_M")

  // OpenAI Model Selection
  openaiTextModel   String @default("gpt-4o")
  openaiVisionModel String @default("gpt-4o")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model Document {
  id             String    @id @default(uuid())
  extractionDate DateTime  @default(now())
  customerName   String
  supplierName   String
  filePath       String    // Path: <extractionDate>/<customerName>-<supplierName>/
  fileName       String
  mimeType       String    @default("application/pdf")
  fileSize       Int?
  metadata       Json?

  // Campi denormalizzati per query/ordinamento
  invoiceId      String?   // Numero fattura estratto
  documentDate   DateTime? // Data documento
  dueDate        DateTime? // Data scadenza pagamento
  totalAmount    Float?    // SQLite uses Float instead of Decimal

  // Storage PDF originale
  pdfStoragePath String?   // Path al file PDF salvato su disco

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users UserOnDocument[]

  @@index([extractionDate])
  @@index([customerName, supplierName])
  @@index([dueDate])
  @@index([supplierName])
  @@map("documents")
}

model UserOnDocument {
  id         String   @id @default(uuid())
  userId     String
  documentId String
  role       String   @default("viewer") // viewer, editor, owner
  assignedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("users_on_documents")
}
